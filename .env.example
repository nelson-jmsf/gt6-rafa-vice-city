# ============================================================================
# GT6 RAFA: FUGA DE VICE CITY (EDTECH PT-13 EDITION)
# Environment Variables Configuration (Supabase + Vercel)
# Copy this file to .env.local for local development or configure in Vercel
# ============================================================================

# 1. Supabase Project URL (Found in Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# 2. Supabase Public Anon Key (Safe for browser & serverless read/insert with RLS)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 3. Optional: Supabase Service Role Key (Serverless API admin operations only)
SUPABASE_SERVICE_ROLE_KEY=

# 4. Local Server Port (Default: 3000)
PORT=3000
